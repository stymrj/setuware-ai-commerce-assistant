# Copy to .env (optional). Never commit .env or .swiggy-tokens.json.
#
# None of these are required to run the live Swiggy demo.
# There is no Swiggy API key. Sign-in is OAuth in the browser:
# phone + OTP happen on Swiggy's own page, and the tokens stay in
# .swiggy-tokens.json on localhost (mode 0600, gitignored).
#
# `npm start` loads this file if you create it. Values already set in
# the environment win over the file.

# Port for the local server. Open http://localhost:3000 (this port).
# Use localhost, not a LAN IP and not 127.0.0.1 in the address bar:
# Swiggy's redirect allowlist for local dev is http://localhost:<port>/auth/callback.
PORT=3000

# Optional. Leave unset for a local run. Set only when the public URL
# cannot be derived from the request (for example a tunnel). It becomes
# the OAuth redirect origin and must match exactly, with no trailing path.
# BASE_URL=http://localhost:3000

# Optional LLM routing. The model only picks a read-only tool. Restaurant,
# menu, price, and cart data still come from the live Swiggy MCP server.
# With neither key set, the built-in keyword router is used.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
