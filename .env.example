# Copy to .env when needed. Never commit .env or .swiggy-tokens.json.
# No key is required: without one the deterministic keyword router runs.
# With a key, the LLM only picks the tool — commerce data always comes
# from the live Swiggy MCP server.
PORT=3000
# BASE_URL=   # optional override for the public URL (e.g. https://your-app.vercel.app).
#             # When unset, the app derives it per request from the proxy
#             # headers, so the OAuth redirect_uri is automatic on Vercel.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
